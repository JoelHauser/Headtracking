<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        HeadTracking.exe sits in the SPT root; everything else it needs lives in HeadTrackingApp\
        beside it, so the root gets two files rather than twenty. The build's own binding redirects
        are merged in below this element.
      -->
      <probing privatePath="HeadTrackingApp" />
    </assemblyBinding>
  </runtime>
</configuration>
